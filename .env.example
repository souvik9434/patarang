# ==========================================
# Patarang Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your local settings.
# NOTE: Patarang uses local-first config storage (data/config.json).
# API keys are stored securely on your local machine and never transmitted to external servers.

# Optional: Default AI Provider (gemini | vertex | openai-compatible)
PATARANG_PROVIDER=gemini

# Optional: API Key for the default provider
# (paste your real key here — never commit the real .env file)
PATARANG_API_KEY=paste-your-api-key-here

# Optional: Custom OpenAI-compatible Base URL
PATARANG_BASE_URL=https://api.openai.com/v1

# Optional: Data storage directory (defaults to ./data)
PATARANG_DATA=./data
